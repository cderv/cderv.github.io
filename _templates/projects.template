$-- Project list for a `type: custom` listing with inline records
$-- (projects.qmd). Fields of each record:
$--   title, href       required
$--   logo              image path (hex sticker, logo), or
$--   icon              a Bootstrap icon name, shown in a hexagon tile
$--   logo-shape        `round` or `cover`
$--   badge             small boxed label after the title
$--   summary, meta     description line and grey role · language line
$-- Styles: styles/site.scss (.gw-project) on top of the talk list styles.
::: {.list .gw-talk-list}
$for(items)$
::: {.gw-talk-item .gw-project}
$if(it.logo)$![]($it.logo$){.gw-project-logo$if(it.logo-shape)$ .gw-project-$it.logo-shape$$endif$} $elseif(it.icon)$[[]{.bi .bi-$it.icon$}]{.gw-project-logo .gw-project-icon} $endif$[$it.title$]($it.href$){.gw-talk-title}$if(it.badge)$ [$it.badge$]{.gw-talk-kind}$endif$

$if(it.summary)$
[$it.summary$]{.gw-talk-summary}

$endif$
$if(it.meta)$
[$it.meta$]{.gw-talk-meta}
$endif$
:::

$endfor$
:::
